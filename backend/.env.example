# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Defaults to a local SQLite file — works out of the box, no Postgres/Docker/cloud needed.
# To match your tech-stack slide later, swap this for a Postgres URL instead:
# DATABASE_URL=postgresql://user:pass@localhost:5432/aws_anomaly
DATABASE_URL=sqlite:///./aws_anomaly.db

# Get this free at https://build.nvidia.com (no credit card needed).
# The app works without it too — /explain will return a clearly-labeled placeholder until you add a real key.
NVIDIA_API_KEY=
